# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# In production every value below is REQUIRED — the app refuses to start
# without them rather than falling back to a known-weak default.

# --- Flask ---------------------------------------------------------------
# "development" enables debug helpers and relaxes the production checks
# below. Anything else (or unset) is treated as production.
FLASK_ENV=development

# Signs session cookies and CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Coordinator login ---------------------------------------------------
# Used for /dashboard and the /api/* routes.
ADMIN_USERNAME=
# Store a hash, not a plaintext password. Generate with:
#   python -c "from werkzeug.security import generate_password_hash as h; print(h(input('password: ')))"
ADMIN_PASSWORD_HASH=

# --- Field devices -------------------------------------------------------
# Shared secret that field phones send with every reading upload. Rotate by
# changing this and re-pairing the phones. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
FIELD_TOKEN=

# --- Database ------------------------------------------------------------
# Defaults to a local SQLite file when unset. In production set the full
# Postgres URL, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# --- Map ---------------------------------------------------------------
# Optional. Without it the dashboard falls back to OpenStreetMap tiles.
# Use a token restricted to your deployment's URL — it is visible to anyone
# who can load the dashboard.
MAPBOX_TOKEN=

# --- Site --------------------------------------------------------------
# Magnetic declination is looked up per reading from this date and the
# observer position. Set to your field site to get a sane default when a
# reading arrives without coordinates.
DEFAULT_SITE_LAT=19.05
DEFAULT_SITE_LON=73.05
