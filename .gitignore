# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets — never commit these.
# NOTE: .gitignore does not apply to files already tracked. If a secret has
# been committed, `git rm --cached` it AND purge it from history, then rotate.
.env
.env.*
!.env.example

# Local databases (field data — treat as sensitive)
*.db
*.sqlite
*.sqlite3

# Audit reports and data exports. These name animals, sessions and the times
# and places they were tracked, which is exactly what the coordinates need
# protecting from. The repository is public; keep them on disk only.
reports/
*-pangolin_raw_bearings*.csv
*-pangolin_fixes*.csv

# Tests
.pytest_cache/
.coverage
